# ===================================================
# Vmax Real Estate - Full Stack Environment Variables
# ===================================================

# ---------------------------------------------------
# Backend (api/.env)
# ---------------------------------------------------
PORT=5000
NODE_ENV=development

# Database Connection (DATABASE_URL is used automatically by Railway)
# DATABASE_URL=postgresql://postgres:password@localhost:5434/vmax
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASS=postgres
DB_NAME=vmax

# JWT Authentication Secret
JWT_SECRET=vmax-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# S3 Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=vmax-property-images

# ---------------------------------------------------
# Frontend (client/.env)
# ---------------------------------------------------
# Leave empty for local development (uses Vite proxy), or set to production API URL
# VITE_API_URL=https://your-api-domain.railway.app/api
VITE_API_URL=
