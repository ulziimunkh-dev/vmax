# Client Environment Variables (Vite)

# Backend API URL (leave empty in local dev to use Vite proxy /api, or specify backend URL in production)
# Example: https://vmax-api-production.up.railway.app/api
VITE_API_URL=

# Mapbox or Leaflet Public Tokens (if required)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
