# ===================================================
# Vmax Real Estate API - Environment Configuration
# ===================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (Option 1: Complete connection string, recommended for Railway / Neon / Supabase)
# DATABASE_URL=postgresql://postgres:password@localhost:5434/vmax
DATABASE_URL=

# Database Connection (Option 2: Individual variables for local PostgreSQL)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASS=postgres
DB_NAME=vmax
DB_SSL=false

# Redis Cache (Optional for dev)
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT Authentication
JWT_SECRET=vmax-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Social OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
APPLE_CLIENT_ID=mn.vmax.web

# SMTP Email Service (Optional for alerts & verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Amazon S3 Credentials (Optional - if omitted, uploads store locally in /uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=vmax-property-images
AWS_S3_FOLDER=development